# EnterpriseOne Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.

# Django Settings
DJANGO_ENV=development
SECRET_KEY=enterpriseone-insecure-development-secret-key-change-in-production-!@#$99
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (MySQL default, auto-fallback to SQLite when unreachable)
DATABASE_ENGINE=mysql
DATABASE_NAME=enterpriseone_db
DATABASE_USER=enterprise_user
DATABASE_PASSWORD=enterprise_password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

# SQLite fallback path when DATABASE_ENGINE is sqlite3 or fallback enabled
SQLITE_DB_NAME=db.sqlite3

# Security & Authentication Settings
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_PASSWORD_REQUIRE_UPPERCASE=True
AUTH_PASSWORD_REQUIRE_LOWERCASE=True
AUTH_PASSWORD_REQUIRE_DIGITS=True
AUTH_PASSWORD_REQUIRE_SPECIAL=True
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_SESSION_COOKIE_AGE_SECONDS=86400
AUTH_SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# Email / Notification Framework (Console backend in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@enterpriseone.internal
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Static & Media
STATIC_URL=/static/
MEDIA_URL=/media/
